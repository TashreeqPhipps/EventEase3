@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<div class="container mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="fw-bold">Bookings</h1>
            <p class="text-muted">View and manage all event bookings, including venue details.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">Create New Booking</a>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Search by booking reference, event, venue, or location..." />
            <button type="submit" class="btn btn-outline-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm p-3">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Booking Reference</th>
                    <th>Booking Date</th>
                    <th>Event Name</th>
                    <th>Venue Name</th>
                    <th>Venue Location</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.BookingReference</td>
                        <td>@item.BookingDate.ToString("dd MMM yyyy")</td>
                        <td>@item.Event?.Name</td>
                        <td>@item.Event?.Venue?.Name</td>
                        <td>@item.Event?.Venue?.Location</td>

                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>