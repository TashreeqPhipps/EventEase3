@model EventEase.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4 fade-in">
    <div class="card shadow-sm p-4">
        <h1 class="fw-bold mb-3">Event Details</h1>
        <p class="text-muted">View the full details of this event.</p>

        <hr />

        <div class="row">
            <div class="col-md-5">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="Event Image" class="img-fluid rounded shadow-sm" style="max-height: 320px; object-fit: cover;" />
                }
                else
                {
                    <div class="border rounded p-5 text-center text-muted">
                        No event image uploaded
                    </div>
                }
            </div>

            <div class="col-md-7">
                <dl class="row">
                    <dt class="col-sm-4">Event Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Event Type</dt>
                    <dd class="col-sm-8">@Model.EventType?.Name</dd>

                    <dt class="col-sm-4">Start Date</dt>
                    <dd class="col-sm-8">@Model.StartDate.ToString("dd MMM yyyy HH:mm")</dd>

                    <dt class="col-sm-4">End Date</dt>
                    <dd class="col-sm-8">@Model.EndDate.ToString("dd MMM yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Venue</dt>
                    <dd class="col-sm-8">@Model.Venue?.Name</dd>

                    <dt class="col-sm-4">Venue Location</dt>
                    <dd class="col-sm-8">@Model.Venue?.Location</dd>

                    <dt class="col-sm-4">Image URL</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <small class="text-muted">@Model.ImageUrl</small>
                        }
                        else
                        {
                            <span class="text-muted">No image URL</span>
                        }
                    </dd>
                </dl>

                <div class="mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-primary">Edit Event</a>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>