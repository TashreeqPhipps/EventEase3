@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Venue Details";
}

<div class="container mt-4 fade-in">
    <div class="card shadow-sm p-4">
        <h1 class="fw-bold mb-3">Venue Details</h1>
        <p class="text-muted">View the full details of this venue.</p>

        <hr />

        <div class="row">
            <div class="col-md-5">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="Venue Image" class="img-fluid rounded shadow-sm" style="max-height: 320px; object-fit: cover;" />
                }
                else
                {
                    <div class="border rounded p-5 text-center text-muted">
                        No image uploaded
                    </div>
                }
            </div>

            <div class="col-md-7">
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Location</dt>
                    <dd class="col-sm-8">@Model.Location</dd>

                    <dt class="col-sm-4">Capacity</dt>
                    <dd class="col-sm-8">@Model.Capacity</dd>

                    <dt class="col-sm-4">Image URL</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <small class="text-muted">@Model.ImageUrl</small>
                        }
                        else
                        {
                            <span class="text-muted">No image URL</span>
                        }
                    </dd>
                </dl>

                <div class="mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn btn-primary">Edit Venue</a>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>